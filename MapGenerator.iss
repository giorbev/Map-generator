; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.
#define MyAppName "Map Generator Pro"
#define MyAppVersion "8.3.0"
#define MyAppPublisher "giorbev"
#define MyAppExeName "MapGeneratorPro.exe"
#define DoubleAmp(Value) StringChange(Value, "&", "&&")
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
AppId={{CE272C90-70C7-4443-AFF6-A1D9CE3C1AA3}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
; Programme par defaut dans Documents (modifiable a la premiere installation) ; une mise a jour
; reprend le dossier de l'installation precedente (UsePreviousAppDir, page du dossier sautee)
DefaultDirName={userdocs}\{#MyAppName}
UsedUserAreasWarning=no
; Icone de l'installeur (img\icone_MGP.ico, tiree de icone_MGP.jpg) ; l'exe porte la meme icone (.spec)
SetupIconFile=img\icone_MGP.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
OutputBaseFilename=MapGeneratorPro_V8.3.0_Setup
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"
Name: "german"; MessagesFile: "compiler:Languages\German.isl"
Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[InstallDelete]
; Mise a jour propre : les fichiers d'une version precedente qui n'existent plus sont retires
; (les donnees de l'utilisateur sont dans leur propre dossier, jamais dans {app})
Type: filesandordirs; Name: "{app}\_internal"

[Files]
Source: "H:\logiciel perso\Map generator\dist\MapGeneratorPro\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "H:\logiciel perso\Map generator\dist\MapGeneratorPro\_internal\*"; DestDir: "{app}\_internal"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#DoubleAmp(MyAppName)}}"; Flags: nowait postinstall skipifsilent

[CustomMessages]
DataDirCaption=Data folder
DataDirDescription=Where should your projects be saved?
DataDirText=Your projects, textures and settings will be saved in this folder. You can change it later in the application (Projects page).
french.DataDirCaption=Dossier des données
french.DataDirDescription=Où enregistrer vos projets ?
french.DataDirText=Vos projets, textures et réglages seront enregistrés dans ce dossier. Vous pourrez le changer plus tard dans l'application (page Projets).

[Code]
// Page « Dossier des données », seulement à la première installation : le choix est écrit dans
// {userappdata}\MapGeneratorPro\location.json, lu par l'application (app/data_location.py).
// Si des données existent déjà (location.json ou ancien Documents\MapGeneratorPro), la page est
// sautée et rien n'est écrit : l'application garde son dossier.
var
  DataDirPage: TInputDirWizardPage;
  AskDataDir: Boolean;

function LocationFile(): String;
begin
  Result := ExpandConstant('{userappdata}\MapGeneratorPro\location.json');
end;

procedure InitializeWizard();
begin
  AskDataDir := not (FileExists(LocationFile()) or DirExists(ExpandConstant('{userdocs}\MapGeneratorPro\data')));
  DataDirPage := CreateInputDirPage(wpSelectDir, CustomMessage('DataDirCaption'),
    CustomMessage('DataDirDescription'), CustomMessage('DataDirText'), True, 'MapGeneratorPro');
  DataDirPage.Add('');
  DataDirPage.Values[0] := ExpandConstant('{userdocs}\MapGeneratorPro');
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := (PageID = DataDirPage.ID) and not AskDataDir;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Dir: String;
  Lines: TArrayOfString;
begin
  if (CurStep = ssPostInstall) and AskDataDir then
  begin
    Dir := RemoveBackslashUnlessRoot(DataDirPage.Values[0]);
    ForceDirectories(Dir);
    ForceDirectories(ExtractFileDir(LocationFile()));
    StringChangeEx(Dir, '\', '\\', True);
    SetArrayLength(Lines, 1);
    Lines[0] := '{"data_dir": "' + Dir + '"}';
    SaveStringsToUTF8File(LocationFile(), Lines, False);
  end;
end;
